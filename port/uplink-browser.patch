+static void RsCopyBrowserImageSidecar ( const char *original, const char *target )
+{
+    char destination[SIZE_RSFILENAME + sizeof(".rgba")];
+    snprintf(destination, sizeof(destination), "%s.rgba", target);
+    // A reused temp0.tif must never pick up the previous image's sidecar.
+    remove(destination);
+    char normalized[SIZE_RSFILENAME];
