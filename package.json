{
  "name": "uplink-private-browser-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Private experimental C++ Uplink WebAssembly workbench; not a licensed public distribution",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "bash port/bootstrap.sh",
    "build": "bash port/build-ftgl.sh && bash port/build-prototype.sh && bash port/link-game.sh",
    "test": "bash port/check.sh",
    "smoke:game": "node port/tests/browser-smoke.cjs game.html",
    "smoke:harness": "node port/tests/browser-smoke.cjs index.html",
    "test:browser-harness": "node port/tests/browser-harness.cjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory prototype",
    "test:browser-lifecycle": "node port/tests/browser-lifecycle.cjs",
    "test:browser-storage": "node port/tests/browser-storage.cjs",
    "prepare:pages": "python3 port/prepare-pages.py",
    "test:pages": "node port/tests/browser-pages.cjs",
    "test:browser-display": "node port/tests/browser-display.cjs",
    "test:browser-renderer-probe": "bash port/tests/build-renderer-probe.sh && node port/tests/browser-renderer-probe.cjs",
    "test:browser-renderer": "bash port/tests/build-game-renderer-qa.sh && node port/tests/browser-renderer.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
